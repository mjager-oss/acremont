# Copy this file to .env and add your Supabase project values.
# Find these in Supabase Dashboard → Project Settings → API.
# In Authentication → URL Configuration, allow your local and production app URLs.
# In Authentication → Providers → Email, enable email confirmations.
# For link + numeric-code verification, include {{ .ConfirmationURL }} and {{ .Token }} in the email template.
# Email verification redirects through the app URL with ?auth=verified and lands on sign-in.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=https://acremontfinance.online
